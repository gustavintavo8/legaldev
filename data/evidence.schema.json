{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legaldev:schema:evidence:0.0.0",
  "$comment": "TODO(PT3/PP-10): esqueleto de lst:det-evidencia (23-detalle.tex), mantenido a mano como contrato independiente de EvidenceDocument (tests/test_evidence.py comprueba que declaran los mismos campos). Pendiente: enumeraciones del cuestionario, patrones de identificadores (A.x.y del Anexo A de ISO/IEC 27001:2022 y medidas del Anexo II del ENS) y fijar la versión del esquema al publicar la primera evidencia.",
  "title": "Evidencia de cumplimiento de LegalDev",
  "description": "Orientación generada automáticamente. No constituye asesoramiento legal ni declaración de aplicabilidad.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generador",
    "generado",
    "request_id",
    "proyecto",
    "obligaciones",
    "sin_tipificar",
    "sin_mapeo",
    "aviso"
  ],
  "properties": {
    "generador": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servicio", "version", "corpus_version", "mapeo_version", "llm_model"],
      "properties": {
        "servicio": { "const": "legaldev" },
        "version": { "type": "string" },
        "corpus_version": { "type": "string" },
        "mapeo_version": { "type": "string" },
        "llm_model": { "type": "string" }
      }
    },
    "generado": { "type": "string", "format": "date-time" },
    "request_id": { "type": "string" },
    "proyecto": {
      "$comment": "Campos cerrados del cuestionario. additionalProperties=false impide que se cuele descripcion_breve (texto libre).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo_proyecto",
        "tiene_usuarios_registrados",
        "acceso_publico",
        "tipos_datos_personales",
        "usuarios_menores",
        "usuarios_ue",
        "transferencia_datos_terceros",
        "usa_ia",
        "usa_cookies",
        "contenido_digital",
        "ccaa",
        "es_empresa"
      ],
      "properties": {
        "tipo_proyecto": { "type": "string" },
        "tiene_usuarios_registrados": { "type": "boolean" },
        "acceso_publico": { "type": "boolean" },
        "tipos_datos_personales": { "type": "array", "items": { "type": "string" } },
        "usuarios_menores": { "type": "boolean" },
        "usuarios_ue": { "type": "boolean" },
        "transferencia_datos_terceros": { "type": "boolean" },
        "usa_ia": { "type": "boolean" },
        "tipo_ia": { "type": ["string", "null"] },
        "usa_cookies": { "type": "boolean" },
        "monetizacion": { "type": ["string", "null"] },
        "contenido_digital": { "type": "boolean" },
        "ccaa": { "type": "string" },
        "es_empresa": { "type": "boolean" },
        "colegiado": { "type": ["boolean", "null"] }
      }
    },
    "obligaciones": { "type": "array", "items": { "$ref": "#/$defs/obligacion" } },
    "sin_tipificar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cita", "motivo"],
        "properties": {
          "cita": { "type": "string" },
          "motivo": {
            "enum": [
              "cita no verificada",
              "cita repartida en varios fragmentos",
              "fragmento sin artículo"
            ]
          }
        }
      }
    },
    "sin_mapeo": {
      "$comment": "Forma pendiente de confirmar: ver el TODO de SinMapeoEvidencia en app/evidence.py.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["normativa", "articulo", "cita"],
        "properties": {
          "normativa": { "type": "string" },
          "articulo": { "type": "string", "minLength": 1 },
          "cita": { "type": "string" }
        }
      }
    },
    "aviso": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "obligacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_tipo",
        "normativa",
        "articulo",
        "pagina",
        "fragmento",
        "cita",
        "cita_verificada",
        "controles",
        "acciones",
        "estado"
      ],
      "properties": {
        "id_tipo": { "type": "string" },
        "normativa": { "type": "string" },
        "articulo": { "type": "string", "minLength": 1 },
        "pagina": { "type": "integer", "minimum": 1 },
        "fragmento": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "cita": { "type": "string" },
        "cita_verificada": { "type": "boolean" },
        "controles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iso27001", "ens"],
          "properties": {
            "iso27001": { "type": "array", "items": { "type": "string" } },
            "ens": { "type": "array", "items": { "type": "string" } }
          }
        },
        "acciones": { "type": "array", "items": { "type": "string" } },
        "estado": { "enum": ["no_iniciado", "en_curso", "implementado", "no_aplica"] }
      }
    }
  }
}
